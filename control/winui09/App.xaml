<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="VICControl.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#EDF4FC" />
          <SolidColorBrush x:Key="NavBrush" Color="#E8F2FE" />
          <SolidColorBrush x:Key="CardBrush" Color="#FAFCFF" />
          <SolidColorBrush x:Key="TileBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LineBrush" Color="#DCE8F6" />
          <SolidColorBrush x:Key="HeadingBrush" Color="#113A7B" />
          <SolidColorBrush x:Key="SecondaryBrush" Color="#667C9B" />
          <SolidColorBrush x:Key="PreviewBrush" Color="#17283D" />
          <SolidColorBrush x:Key="ConsoleBrush" Color="#102033" />
          <SolidColorBrush x:Key="ConsoleTextBrush" Color="#D9E9FB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#111D2D" />
          <SolidColorBrush x:Key="NavBrush" Color="#182B42" />
          <SolidColorBrush x:Key="CardBrush" Color="#1D2E43" />
          <SolidColorBrush x:Key="TileBrush" Color="#263A50" />
          <SolidColorBrush x:Key="LineBrush" Color="#38516C" />
          <SolidColorBrush x:Key="HeadingBrush" Color="#D8E9FF" />
          <SolidColorBrush x:Key="SecondaryBrush" Color="#A9BFDA" />
          <SolidColorBrush x:Key="PreviewBrush" Color="#08131F" />
          <SolidColorBrush x:Key="ConsoleBrush" Color="#07111E" />
          <SolidColorBrush x:Key="ConsoleTextBrush" Color="#D9E9FB" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
      </Style>
      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
